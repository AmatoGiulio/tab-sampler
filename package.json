{
  "name": "tab-sampler",
  "version": "0.0.2",
  "private": true,
  "description": "A minimal Chrome tab sampler: click, listen, click, trim, loop, export.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "showcase": "vite --host 127.0.0.1 --port 5173 --strictPort --open /showcase/recorder-motion/"
  },
  "dependencies": {
    "@audio/encode-wav": "1.3.2",
    "@webext-core/messaging": "4.0.0",
    "idb": "8.0.3",
    "motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wavesurfer.js": "8.0.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "5.9.2",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  },
  "packageManager": "npm@10.9.2"
}
